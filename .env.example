# Postgres connection URL.
# Example: postgres://user:password@127.0.0.1:5432/your-database-name
# Required
DATABASE_URL=

# Payload secret. Should be a cryptographically strong random string.
# Can be generated with `openssl rand -hex 24`
# Required
PAYLOAD_SECRET=

# Defines the URL of this Payload instance.
# Required
SERVER_URL=

# URL of the frontend web app. Will also be used to set CORS.
# Required
FRONTEND_URL=

# Email settings.
#SMTP_HOST=
#SMTP_USER=
#SMTP_PASS=
#SMTP_DEFAULT_FROM_ADDRESS=
#SMTP_DEFAULT_FROM_NAME=


# S3 bucket settings for media uploads
#S3_BUCKET=bucket-name
#S3_REGION=fra1
# example: https://[region].digitaloceanspaces.com
#S3_ENDPOINT=
# example: https://[bucket-name].[region].cdn.digitaloceanspaces.com
#S3_CDN_ENDPOINT=
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=


# Sentry/GlitchTip error reporting. Sentry is disabled when the DSN is not set.
# For docker builds, these values are built into the image so if you change the values, it needs a rebuild.
#NEXT_PUBLIC_SENTRY_DSN=
# Where source maps are uploaded during the build. The auth token for local builds lives in .env.sentry-build-plugin.
# example: https://glitchtip.example.com/
#SENTRY_URL=
#SENTRY_ORG=
#SENTRY_PROJECT=
# For uploading source maps. Not used in dev server but is used in production build.
#SENTRY_AUTH_TOKEN=
